{
  "name": "tg_tipok_audit_bot",
  "private": "true",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @sa/server",
    "dev:miniapp": "npm run dev -w @sa/miniapp",
    "build": "npm run build -w @sa/miniapp && npm run build -w @sa/server",
    "start": "npm run start -w @sa/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @sa/db",
    "db:migrate": "npm run migrate -w @sa/db",
    "db:push": "npm run push -w @sa/db",
    "db:seed": "npm run seed -w @sa/db",
    "db:studio": "npm run studio -w @sa/db"
  },
  "repository": {
    "type": "git",
    "url": "https://github/Yasenuk/TG_Tipok_Audit_Bot.git"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Yatseniuk Vladyslav"
}
