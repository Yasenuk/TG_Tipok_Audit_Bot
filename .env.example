# --- core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- telegram ---
BOT_TOKEN=
# Публічний https-домен сервера (Render). Порожній у dev — бот іде в long polling.
PUBLIC_URL=
# URL міні-апки, якщо він інший (тунель у dev). За замовчуванням = PUBLIC_URL.
MINIAPP_URL=
# Твій Telegram ID — сід зробить із нього адміністратора. Бот скаже його по /id.
SEED_ADMIN_TG_ID=

# --- cloudflare r2 ---
# R2 > Manage API tokens > Object Read & Write. Без них фото віддають 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=store-audit-photos
